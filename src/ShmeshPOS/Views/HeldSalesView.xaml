<UserControl x:Class="ShmeshPOS.Views.HeldSalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ShmeshPOS.Views">
    <Grid Background="{StaticResource OverlayBrush}">
        <Border Style="{StaticResource OverlayCard}" Width="820" Height="600">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock DockPanel.Dock="Right" Text="Esc to close  ·  ↑↓ Enter to retrieve" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="RETRIEVE SALE" Style="{StaticResource Heading}" />
                </DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Close" Style="{StaticResource PosButton}" HorizontalAlignment="Right" MinWidth="160"
                        Margin="0,14,0,0" Command="{Binding CloseCommand}" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="18" Margin="4,8"
                           Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Padding="16,10,10,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="Transparent">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Sale.Total, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                                                           Margin="0,0,16,0" Foreground="{StaticResource TextBrush}" />
                                                <Button Content="Delete" Style="{StaticResource DangerButton}" FontSize="15" MinHeight="46" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=views:HeldSalesView}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Retrieve" Style="{StaticResource PrimaryButton}" FontSize="15" MinHeight="46"
                                                        Command="{Binding DataContext.RetrieveCommand, RelativeSource={RelativeSource AncestorType=views:HeldSalesView}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <TextBlock FontSize="14" Foreground="{StaticResource MutedTextBrush}">
                                                    <Run Text="{Binding Sale.ItemCount, Mode=OneWay, StringFormat={}{0} items}" /><Run Text="   ·   " /><Run Text="{Binding Sale.Time, Mode=OneWay, StringFormat={}{0:h:mm tt}}" /><Run Text="{Binding Sale.Cashier, Mode=OneWay, StringFormat={}   ·   {0}}" /><Run Text="{Binding Sale.Terminal, Mode=OneWay, StringFormat={} on {0}}" /><Run Text="{Binding Sale.CustomerName, Mode=OneWay, StringFormat={}   ·   customer {0}}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
