<UserControl x:Class="ShmeshPOS.Views.Admin.ProductsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:admin="clr-namespace:ShmeshPOS.Views.Admin">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="470" />
        </Grid.ColumnDefinitions>

        <!-- ===== List ===== -->
        <DockPanel>
            <admin:AdminListHeader DockPanel.Dock="Top" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding MainScreenSummary}" FontSize="14" FontWeight="SemiBold"
                       Foreground="#1E40AF" Margin="2,0,0,8" />
            <Border Style="{StaticResource Card}" CornerRadius="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,10,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PRODUCT" Style="{StaticResource FormLabel}" Margin="18,0,0,0" />
                        <TextBlock Grid.Column="1" Text="CATEGORY" Style="{StaticResource FormLabel}" />
                        <TextBlock Grid.Column="2" Text="PRICE" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="TAX" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                            Background="Transparent" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                                          Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=admin:ProductsAdminView}}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                     Fill="{Binding Item.Category.Color, TargetNullValue=#64748B, FallbackValue=#64748B}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Item.Name}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <Border Style="{StaticResource DisabledPill}" Margin="10,0,0,0"
                                                            Visibility="{Binding Item.IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                        <TextBlock Text="Disabled" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource DisabledPill}" Background="#DBEAFE" Margin="10,0,0,0"
                                                            Visibility="{Binding Item.ShowOnMainScreen, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="&#x2605; Main screen" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" />
                                                    </Border>
                                                    <Border Style="{StaticResource DisabledPill}" Background="#F1F5F9" Margin="10,0,0,0"
                                                            Visibility="{Binding Item.TrackStock, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding Item.StockQuantity, StringFormat={}{0} on hand}" FontSize="12" FontWeight="Bold" Foreground="#334155" />
                                                    </Border>
                                                    <Border Style="{StaticResource DisabledPill}" Background="#FEF3C7" Margin="10,0,0,0"
                                                            Visibility="{Binding Item.IsLowOnStock, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="Low stock" FontSize="12" FontWeight="Bold" Foreground="#92400E" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource JoinNonEmpty}" ConverterParameter="Code|SKU|Barcode">
                                                            <Binding Path="Item.Code" />
                                                            <Binding Path="Item.Sku" />
                                                            <Binding Path="Item.Barcode" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Item.Category.Name}" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Item.Price, StringFormat={}{0:C}}" FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Item.TaxRate, StringFormat={}{0:0.###%}}" FontSize="15"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ===== Editor ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" CornerRadius="12" Padding="22,18">
            <DockPanel>
                <admin:AdminEditorFooter DockPanel.Dock="Bottom" Margin="0,12,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Editor}">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" Margin="0,0,0,16" />

                        <StackPanel Style="{StaticResource FormField}">
                            <TextBlock Text="NAME" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource FormBox}" MaxLength="100" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FormField}">
                            <TextBlock Text="CATEGORY" Style="{StaticResource FormLabel}" />
                            <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Margin="0,0,10,0" Fill="{Binding Color, TargetNullValue=#64748B}" />
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="  (disabled)" Foreground="{StaticResource MutedTextBrush}"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PRICE ($)" Style="{StaticResource FormLabel}" />
                                <TextBox Style="{StaticResource FormBox}" TextAlignment="Right" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TAX RATE (%)" Style="{StaticResource FormLabel}" />
                                <TextBox Style="{StaticResource FormBox}" TextAlignment="Right" Text="{Binding TaxPercentText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Prices exclude tax. Enter the tax rate as a percentage, e.g. 8.875." Style="{StaticResource FormHint}" Margin="0,-8,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PRODUCT CODE" Style="{StaticResource FormLabel}" />
                                <TextBox Style="{StaticResource FormBox}" MaxLength="20" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SKU" Style="{StaticResource FormLabel}" />
                                <TextBox Style="{StaticResource FormBox}" MaxLength="50" Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Style="{StaticResource FormField}">
                            <TextBlock Text="BARCODE" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource FormBox}" MaxLength="50" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Click here and scan the item to fill it in. Code, SKU and barcode must each be unique." Style="{StaticResource FormHint}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="BUTTON ORDER" Style="{StaticResource FormLabel}" />
                                <TextBox Style="{StaticResource FormBox}" TextAlignment="Right" Text="{Binding SortOrderText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource FormCheck}" Content="Available for sale" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                      IsChecked="{Binding IsActive}" />
                        </Grid>
                        <TextBlock Text="Unticking hides the product from the register. Past sales are kept." Style="{StaticResource FormHint}" />

                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,14,0,0">
                            <StackPanel>
                                <CheckBox Style="{StaticResource FormCheck}" Content="&#x2605; Show on main screen" IsChecked="{Binding ShowOnMainScreen}" />
                                <TextBlock Style="{StaticResource FormHint}"
                                           Text="Up to 10 products appear as big buttons on the register, in button order. Other products are found by search or barcode." />
                            </StackPanel>
                        </Border>

                        <!-- ===== Stock ===== -->
                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14,12" Margin="0,14,0,0">
                            <StackPanel>
                                <CheckBox Style="{StaticResource FormCheck}" Content="Track stock" IsChecked="{Binding TrackStock}" />
                                <TextBlock Style="{StaticResource FormHint}"
                                           Text="Sales take stock out; returns and deliveries put it back. Selling never stops when stock runs out." />
                                <StackPanel Visibility="{Binding TrackStock, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                                    <TextBlock Text="LOW-STOCK LEVEL" Style="{StaticResource FormLabel}" />
                                    <TextBox Style="{StaticResource FormBox}" TextAlignment="Right" Width="140" HorizontalAlignment="Left"
                                             Text="{Binding ReorderLevelText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Marked “Low stock” at or below this quantity. Blank: when it runs out." Style="{StaticResource FormHint}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- On hand, deliveries, counts and history: saved products that track stock -->
                        <StackPanel Visibility="{Binding WasTrackingStock, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                            <Border Background="{StaticResource ChromeBrush}" CornerRadius="12" Padding="18,12">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ON HAND" FontSize="16" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                        <TextBlock Text="Low stock" FontSize="13" FontWeight="Bold" Foreground="#FCD34D"
                                                   Visibility="{Binding IsLowOnStock, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StockQuantity}" FontSize="30" FontWeight="Black" Foreground="White" HorizontalAlignment="Right" />
                                </DockPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Delivery or stock count" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Receive adds a delivery. Count sets the quantity to what is on the shelf." Style="{StaticResource FormHint}" Margin="0,2,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="QUANTITY" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" TextAlignment="Right" Text="{Binding StockAmountText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="NOTE (OPTIONAL)" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" MaxLength="200" Text="{Binding StockNote, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Receive" Style="{StaticResource PosButton}" FontSize="16" MinHeight="46" MinWidth="120" Margin="0,0,10,0"
                                                Command="{Binding DataContext.ReceiveStockCommand, RelativeSource={RelativeSource AncestorType=admin:ProductsAdminView}}" />
                                        <Button Content="Set Count" Style="{StaticResource PosButton}" FontSize="16" MinHeight="46" MinWidth="120"
                                                Command="{Binding DataContext.CountStockCommand, RelativeSource={RelativeSource AncestorType=admin:ProductsAdminView}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="STOCK HISTORY" Style="{StaticResource FormLabel}" Margin="0,18,0,6" />
                            <TextBlock Text="{Binding HistoryMessage}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Visibility="{Binding HistoryMessage, Converter={StaticResource NullToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">
                                                        <Run Text="{Binding Type, Mode=OneWay}" /><Run Text="{Binding Sale.ReceiptNumber, Mode=OneWay, StringFormat={}  {0}}" FontWeight="Normal" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                                                        <Run Text="{Binding CreatedAt, Mode=OneWay, Converter={StaticResource UtcToLocal}, StringFormat={}{0:MMM d, yyyy h:mm tt}}" /><Run Text="{Binding User.DisplayName, Mode=OneWay, StringFormat={}  ·  {0}}" /><Run Text="{Binding Note, Mode=OneWay, StringFormat={}  ·  {0}}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Change, StringFormat={}{0:+0;−0;0}}" FontSize="15" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding QuantityAfter}" FontSize="15"
                                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
