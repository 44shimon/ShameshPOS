<UserControl x:Class="ShmeshPOS.Views.Admin.AdminEditorFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared save bar. DataContext is the section view model. -->
    <StackPanel>
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" TextAlignment="Left" Margin="0,0,0,10"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
        <TextBlock Text="{Binding StatusMessage}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SuccessDarkBrush}" Margin="0,0,0,10"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
        <UniformGrid Columns="2">
            <Button Content="Undo Changes" Style="{StaticResource PosButton}" Margin="0,0,6,0" Command="{Binding RevertCommand}"
                    IsEnabled="{Binding Editor.IsDirty}" />
            <Button Style="{StaticResource SuccessButton}" FontSize="19" Margin="6,0,0,0" Command="{Binding SaveCommand}">
                <TextBlock><Run Text="Save" /><Run Text="  Ctrl+S" FontSize="13" FontWeight="SemiBold" /></TextBlock>
            </Button>
        </UniformGrid>
    </StackPanel>
</UserControl>
