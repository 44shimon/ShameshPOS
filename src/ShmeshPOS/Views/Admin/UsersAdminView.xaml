<UserControl x:Class="ShmeshPOS.Views.Admin.UsersAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:admin="clr-namespace:ShmeshPOS.Views.Admin"
             xmlns:controls="clr-namespace:ShmeshPOS.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="470" />
        </Grid.ColumnDefinitions>

        <!-- ===== List ===== -->
        <DockPanel>
            <admin:AdminListHeader DockPanel.Dock="Top" />
            <Border Style="{StaticResource Card}" CornerRadius="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,10,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NAME" Style="{StaticResource FormLabel}" />
                        <TextBlock Grid.Column="1" Text="USERNAME" Style="{StaticResource FormLabel}" />
                        <TextBlock Grid.Column="2" Text="ROLE" Style="{StaticResource FormLabel}" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Padding="16,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                            Background="Transparent" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                                          Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=admin:UsersAdminView}}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Item.DisplayName}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <Border Style="{StaticResource DisabledPill}" Margin="10,0,0,0"
                                                        Visibility="{Binding Item.IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                    <TextBlock Text="Disabled" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Item.Username}" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Item.Role}" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ===== Editor ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" CornerRadius="12" Padding="22,18">
            <DockPanel>
                <admin:AdminEditorFooter DockPanel.Dock="Bottom" Margin="0,12,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Editor}">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" Margin="0,0,0,16" />

                        <StackPanel Style="{StaticResource FormField}">
                            <TextBlock Text="DISPLAY NAME" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource FormBox}" MaxLength="100" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Shown on the register and on sales records." Style="{StaticResource FormHint}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FormField}">
                            <TextBlock Text="USERNAME" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource FormBox}" MaxLength="50" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ROLE" Style="{StaticResource FormLabel}" />
                                <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"
                                          IsEnabled="{Binding CanChangeAccess}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource FormCheck}" Content="Can log in" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                      IsChecked="{Binding IsActive}" IsEnabled="{Binding CanChangeAccess}" />
                        </Grid>
                        <TextBlock Text="This is your own account, so its role and login access can't be changed here."
                                   Style="{StaticResource FormHint}" Margin="0,-8,0,14"
                                   Visibility="{Binding IsSelf, Converter={StaticResource BoolToVisibility}}" />

                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="16,14">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Change PIN" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                    <Setter Property="Text" Value="Set PIN" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="NEW PIN" Style="{StaticResource FormLabel}" />
                                        <PasswordBox Style="{StaticResource FormPin}" controls:PasswordBoxBinding.Password="{Binding NewPin}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="REPEAT PIN" Style="{StaticResource FormLabel}" />
                                        <PasswordBox Style="{StaticResource FormPin}" controls:PasswordBoxBinding.Password="{Binding ConfirmPin}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding PinHint}" Style="{StaticResource FormHint}" Margin="0,8,0,0" />
                                <TextBlock Text="Avoid easy PINs like 1111 or 1234." Style="{StaticResource FormHint}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
