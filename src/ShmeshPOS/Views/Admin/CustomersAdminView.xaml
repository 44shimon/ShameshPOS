<UserControl x:Class="ShmeshPOS.Views.Admin.CustomersAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:admin="clr-namespace:ShmeshPOS.Views.Admin">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="500" />
        </Grid.ColumnDefinitions>

        <!-- ===== List ===== -->
        <DockPanel>
            <admin:AdminListHeader DockPanel.Dock="Top" />
            <Border Style="{StaticResource Card}" CornerRadius="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,10,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CUSTOMER" Style="{StaticResource FormLabel}" />
                        <TextBlock Grid.Column="1" Text="OWES" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="LIMIT" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                            Background="Transparent" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                                          Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=admin:CustomersAdminView}}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Item.Customer.Name}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <Border Style="{StaticResource DisabledPill}" Margin="10,0,0,0"
                                                            Visibility="{Binding Item.Customer.IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                        <TextBlock Text="Closed" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource DisabledPill}" Margin="10,0,0,0"
                                                            Visibility="{Binding Item.IsOverLimit, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="Over limit" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource JoinNonEmpty}" ConverterParameter="#|">
                                                            <Binding Path="Item.Customer.AccountNumber" />
                                                            <Binding Path="Item.Customer.Phone" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Item.Customer.Balance, StringFormat={}{0:C}}" FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Item.EffectiveLimit, StringFormat={}{0:C}}" FontSize="15" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="store default" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}"
                                                           Visibility="{Binding Item.UsesDefaultLimit, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ===== Editor ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" CornerRadius="12" Padding="22,18">
            <DockPanel>
                <admin:AdminEditorFooter DockPanel.Dock="Bottom" Margin="0,12,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Editor}">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" Margin="0,0,0,16" />

                        <StackPanel Style="{StaticResource FormField}">
                            <TextBlock Text="NAME" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource FormBox}" MaxLength="100" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ACCOUNT NUMBER" Style="{StaticResource FormLabel}" />
                                <TextBox Style="{StaticResource FormBox}" MaxLength="20" Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PHONE" Style="{StaticResource FormLabel}" />
                                <TextBox Style="{StaticResource FormBox}" MaxLength="30" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Leave the account number blank to assign the next number automatically." Style="{StaticResource FormHint}" Margin="0,-8,0,14"
                                   Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Style="{StaticResource FormField}">
                            <TextBlock Text="EMAIL" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource FormBox}" MaxLength="200" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FormField}">
                            <TextBlock Text="NOTES" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource FormBox}" MaxLength="500" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Credit limit -->
                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Credit limit" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="The most this customer may owe. Charges that would go over it are refused at the register."
                                           Style="{StaticResource FormHint}" Margin="0,2,0,10" />
                                <CheckBox Style="{StaticResource FormCheck}" Content="{Binding DefaultLimitLabel}" IsChecked="{Binding UseDefaultLimit}" />
                                <DockPanel Margin="0,10,0,0" Visibility="{Binding UseOwnLimit, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Own limit ($)" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextBrush}" />
                                    <TextBox Style="{StaticResource FormBox}" TextAlignment="Right" Text="{Binding CreditLimitText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBlock Text="Set 0.00 to stop this customer charging to their account." Style="{StaticResource FormHint}"
                                           Visibility="{Binding UseOwnLimit, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <CheckBox Style="{StaticResource FormCheck}" Content="Account open" IsChecked="{Binding IsActive}" Margin="0,0,0,4" />
                        <TextBlock Text="Closed accounts can't be found or charged at the register. History is kept." Style="{StaticResource FormHint}" />

                        <!-- Balance, adjustment and history: existing customers only -->
                        <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" Margin="0,20,0,0">
                            <Border Background="{StaticResource ChromeBrush}" CornerRadius="12" Padding="18,12">
                                <DockPanel>
                                    <TextBlock Text="OWES" FontSize="16" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Balance, StringFormat={}{0:C}}" FontSize="30" FontWeight="Black" Foreground="White" HorizontalAlignment="Right" />
                                </DockPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Adjust balance" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="For corrections only. Payments are taken at the register (F4 → Take Payment)." Style="{StaticResource FormHint}" Margin="0,2,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="AMOUNT (+/−)" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" TextAlignment="Right" Text="{Binding AdjustAmountText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="REASON" Style="{StaticResource FormLabel}" />
                                            <TextBox Style="{StaticResource FormBox}" MaxLength="500" Text="{Binding AdjustNote, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="Apply Adjustment" Style="{StaticResource PosButton}" FontSize="16" MinHeight="46" Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding DataContext.AdjustBalanceCommand, RelativeSource={RelativeSource AncestorType=admin:CustomersAdminView}}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ACCOUNT HISTORY" Style="{StaticResource FormLabel}" Margin="0,18,0,6" />
                            <TextBlock Text="{Binding HistoryMessage}" Style="{StaticResource Muted}"
                                       Visibility="{Binding HistoryMessage, Converter={StaticResource NullToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">
                                                        <Run Text="{Binding Type, Mode=OneWay}" /><Run Text="{Binding Sale.ReceiptNumber, Mode=OneWay, StringFormat={}  {0}}" FontWeight="Normal" /><Run Text="{Binding PaymentMethod.Name, Mode=OneWay, StringFormat={}  by {0}}" FontWeight="Normal" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                                                        <Run Text="{Binding CreatedAt, Mode=OneWay, Converter={StaticResource UtcToLocal}, StringFormat={}{0:MMM d, yyyy h:mm tt}}" /><Run Text="{Binding User.DisplayName, Mode=OneWay, StringFormat={}  ·  {0}}" /><Run Text="{Binding Note, Mode=OneWay, StringFormat={}  ·  {0}}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:+$0.00;−$0.00}}" FontSize="15" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding BalanceAfter, StringFormat={}{0:C}}" FontSize="15"
                                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
