<UserControl x:Class="ShmeshPOS.Views.Admin.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:import="clr-namespace:ShmeshPOS.Services.Import">
    <UserControl.Resources>
        <Style x:Key="Count" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Black" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource OverlayBrush}">
        <Border Style="{StaticResource OverlayCard}" Width="940" MaxHeight="660">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Right" Text="Esc to close" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
                </DockPanel>

                <!-- Messages shared by every stage -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" TextAlignment="Left" Margin="0,0,0,10"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="15" Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />

                    <!-- Intro buttons -->
                    <DockPanel Visibility="{Binding IsIntro, Converter={StaticResource BoolToVisibility}}">
                        <Button DockPanel.Dock="Right" Content="Choose File…" Style="{StaticResource PrimaryButton}" MinWidth="200" Command="{Binding ChooseFileCommand}" />
                        <Button DockPanel.Dock="Right" Content="Save Template…" Style="{StaticResource PosButton}" Margin="0,0,10,0" Command="{Binding SaveTemplateCommand}" />
                        <Button Content="Cancel" Style="{StaticResource PosButton}" HorizontalAlignment="Left" MinWidth="140" Command="{Binding CloseCommand}" />
                    </DockPanel>

                    <!-- Preview buttons -->
                    <DockPanel Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SuccessButton}" FontSize="19" MinWidth="240"
                                Content="{Binding ImportLabel}" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}" />
                        <Button DockPanel.Dock="Right" Content="Choose Another File…" Style="{StaticResource PosButton}" Margin="0,0,10,0" Command="{Binding ChooseFileCommand}" />
                        <Button Content="Cancel" Style="{StaticResource PosButton}" HorizontalAlignment="Left" MinWidth="140" Command="{Binding CloseCommand}" />
                    </DockPanel>

                    <!-- Done -->
                    <Button Content="Done" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="200" Command="{Binding CloseCommand}"
                            Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <Grid>
                    <!-- ===== Intro ===== -->
                    <StackPanel Visibility="{Binding IsIntro, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="17" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" LineHeight="26"
                                   Text="Choose an Excel (.xlsx, .xls) or CSV file. The first row must hold the column headings. You'll see exactly what will change before anything is saved." />
                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="18,14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="COLUMNS" Style="{StaticResource FormLabel}" />
                                <TextBlock Text="{Binding ColumnsHelp}" FontSize="15.5" TextWrapping="Wrap" LineHeight="24" Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Preview ===== -->
                    <DockPanel Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock FontSize="15" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                                <Run Text="{Binding Plan.FileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run Text="   ·   Columns found: " /><Run Text="{Binding ColumnsFound, Mode=OneWay}" />
                            </TextBlock>

                            <UniformGrid Rows="1" Margin="0,12,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Plan.CreateCount}" Style="{StaticResource Count}" Foreground="{StaticResource SuccessBrush}" />
                                    <TextBlock Text="new" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Plan.UpdateCount}" Style="{StaticResource Count}" Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text="will be updated" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Plan.UnchangedCount}" Style="{StaticResource Count}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="already up to date" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Plan.ErrorCount}" Style="{StaticResource Count}" Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Text="have problems (skipped)" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </UniformGrid>

                            <ItemsControl ItemsSource="{Binding Plan.Notes}" Margin="0,4,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FEF3C7" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding}" FontSize="14.5" TextWrapping="Wrap" Foreground="#78350F" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <CheckBox Style="{StaticResource FormCheck}" Content="Show only rows with problems" IsChecked="{Binding ProblemsOnly}" Margin="0,4,0,8" />
                        </StackPanel>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                <ItemsControl ItemsSource="{Binding VisibleRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Line, StringFormat=Row {0}}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" Margin="0,0,8,0" />
                                                    <Border Grid.Column="2" x:Name="Pill" CornerRadius="999" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Background="#E2E8F0">
                                                        <TextBlock x:Name="PillText" Text="{Binding Action}" FontSize="12" FontWeight="Bold" Foreground="#334155" />
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextBrush}" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Action}" Value="{x:Static import:ImportAction.Create}">
                                                    <Setter TargetName="Pill" Property="Background" Value="#DCFCE7" />
                                                    <Setter TargetName="PillText" Property="Foreground" Value="#166534" />
                                                    <Setter TargetName="PillText" Property="Text" Value="New" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="{x:Static import:ImportAction.Update}">
                                                    <Setter TargetName="Pill" Property="Background" Value="#DBEAFE" />
                                                    <Setter TargetName="PillText" Property="Foreground" Value="#1E40AF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Action}" Value="{x:Static import:ImportAction.Error}">
                                                    <Setter TargetName="Pill" Property="Background" Value="#FEE2E2" />
                                                    <Setter TargetName="PillText" Property="Foreground" Value="#991B1B" />
                                                    <Setter TargetName="PillText" Property="Text" Value="Problem" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>

                    <!-- ===== Done ===== -->
                    <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" Margin="0,20">
                        <TextBlock Text="Import complete" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessDarkBrush}" />
                        <TextBlock Text="{Binding ResultText}" FontSize="19" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Changes appear on the register as soon as you go back to it." Style="{StaticResource Muted}" Margin="0,10,0,0" />
                    </StackPanel>

                    <!-- Busy veil -->
                    <Border Background="#CCFFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Working…" Style="{StaticResource Heading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
