<UserControl x:Class="ShmeshPOS.Views.Admin.AdminListHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared by every admin section: its DataContext is the section view model (Title, FilterText, NewCommand…). -->
    <StackPanel>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinHeight="46" FontSize="16"
                    Command="{Binding NewCommand}">
                <TextBlock><Run Text="+ " /><Run Text="{Binding NewLabel, Mode=OneWay}" /></TextBlock>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource PosButton}" MinHeight="46" FontSize="16" Margin="0,0,10,0"
                    Content="Import…" Command="{Binding OpenImportCommand}"
                    Visibility="{Binding CanImport, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" total" /></TextBlock>
            </StackPanel>
        </DockPanel>
        <DockPanel Margin="0,14,0,10">
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource FormCheck}" Content="Show disabled" Margin="16,0,0,0"
                      IsChecked="{Binding ShowDisabled}" VerticalAlignment="Center" />
            <Grid>
                <TextBox x:Name="Filter" Style="{StaticResource FormBox}" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Filter…" FontSize="17" Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding FilterText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
            </Grid>
        </DockPanel>
    </StackPanel>
</UserControl>
