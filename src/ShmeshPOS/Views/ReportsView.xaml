<UserControl x:Class="ShmeshPOS.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ShmeshPOS.Views">
    <UserControl.Resources>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="Kpi" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Name ........ count ...... amount rows -->
        <DataTemplate x:Key="NamedTotalRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="15" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:C}}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"
                           Foreground="{StaticResource TextBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Monospace "paper" preview of a receipt or printed report -->
        <DataTemplate x:Key="PaperLine">
            <TextBlock Text="{Binding}" FontFamily="Consolas, Courier New" FontSize="13" xml:space="preserve" Foreground="#1F2937" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Top bar: title, period, back ===== -->
        <Border Background="{StaticResource ChromeBrush}">
            <DockPanel Margin="20,0">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="SHMESH POS" FontSize="13" FontWeight="Black" Foreground="#94A3B8" />
                    <TextBlock Text="Reports" FontSize="22" FontWeight="Bold" Foreground="White" />
                </StackPanel>

                <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Command="{Binding BackCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Back to Register" />
                        <Border Style="{StaticResource KeyHint}"><TextBlock Text="Esc" FontSize="13" /></Border>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Today" Command="{Binding SetPresetCommand}" CommandParameter="Today">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PresetButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preset}" Value="Today">
                                        <Setter Property="Background" Value="{StaticResource ChromeAltBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Yesterday" Command="{Binding SetPresetCommand}" CommandParameter="Yesterday">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PresetButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preset}" Value="Yesterday">
                                        <Setter Property="Background" Value="{StaticResource ChromeAltBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="This Week" Command="{Binding SetPresetCommand}" CommandParameter="Week">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PresetButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preset}" Value="Week">
                                        <Setter Property="Background" Value="{StaticResource ChromeAltBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="This Month" Command="{Binding SetPresetCommand}" CommandParameter="Month">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PresetButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preset}" Value="Month">
                                        <Setter Property="Background" Value="{StaticResource ChromeAltBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="From" Foreground="#94A3B8" FontSize="15" VerticalAlignment="Center" Margin="18,0,8,0" />
                    <DatePicker SelectedDate="{Binding FromDate}" FontSize="15" Width="140" VerticalAlignment="Center" />
                    <TextBlock Text="to" Foreground="#94A3B8" FontSize="15" VerticalAlignment="Center" Margin="8,0" />
                    <DatePicker SelectedDate="{Binding ToDate}" FontSize="15" Width="140" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="20,16,20,20">
            <!-- Tabs + messages -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource SuccessDarkBrush}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Summary" MinWidth="140" Command="{Binding ShowTabCommand}" CommandParameter="Summary">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PosButton}">
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSummaryTab}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button MinWidth="140" Command="{Binding ShowTabCommand}" CommandParameter="Sales">
                        <TextBlock><Run Text="Sales" /><Run Text="{Binding Summary.SaleCount, Mode=OneWay, StringFormat={}  ({0})}" /></TextBlock>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PosButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSalesTab}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button MinWidth="140" Command="{Binding ShowTabCommand}" CommandParameter="Shifts">
                        <TextBlock><Run Text="Shifts" /><Run Text="{Binding Shifts.Count, Mode=OneWay, StringFormat='{}  ({0})'}" /></TextBlock>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PosButton}">
                                <Setter Property="Margin" Value="8,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShiftsTab}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding PeriodText}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <!-- ===== Summary ===== -->
                <Grid Visibility="{Binding IsSummaryTab, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <UniformGrid Rows="1" Margin="0,0,-12,16">
                                <Border Style="{StaticResource Kpi}">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL SALES" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding Summary.Total, StringFormat={}{0:C}}" FontSize="30" FontWeight="Black" Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Kpi}">
                                    <StackPanel>
                                        <TextBlock Text="SALES" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding Summary.SaleCount}" FontSize="30" FontWeight="Black" Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Kpi}">
                                    <StackPanel>
                                        <TextBlock Text="AVERAGE SALE" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding Summary.AverageSale, StringFormat={}{0:C}}" FontSize="30" FontWeight="Black" Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Kpi}">
                                    <StackPanel>
                                        <TextBlock Text="ITEMS SOLD" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding Summary.ItemsSold}" FontSize="30" FontWeight="Black" Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Kpi}">
                                    <StackPanel>
                                        <TextBlock Text="TAX" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding Summary.Tax, StringFormat={}{0:C}}" FontSize="30" FontWeight="Black" Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Columns="2" Margin="0,0,-16,0">
                                <!-- Payments -->
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,16,16">
                                    <StackPanel>
                                        <TextBlock Text="PAYMENTS" Style="{StaticResource SectionTitle}" />
                                        <ItemsControl ItemsSource="{Binding Summary.ByPaymentMethod}" ItemTemplate="{StaticResource NamedTotalRow}" />
                                    </StackPanel>
                                </Border>

                                <!-- Cash drawer -->
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,16,16">
                                    <StackPanel>
                                        <TextBlock Text="CASH DRAWER" Style="{StaticResource SectionTitle}" />
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.CashSales, StringFormat={}{0:C}}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="Cash sales" FontSize="15" />
                                        </DockPanel>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.CashAccountPayments, StringFormat={}{0:C}}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="Cash paid on accounts" FontSize="15" />
                                        </DockPanel>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.CashRefunds, StringFormat={}-{0:C}}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource DangerBrush}" />
                                            <TextBlock Text="Cash refunds" FontSize="15" />
                                        </DockPanel>
                                        <DockPanel Margin="0,8,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.ExpectedCash, StringFormat={}{0:C}}" FontSize="22" FontWeight="Black"
                                                       Foreground="{StaticResource SuccessDarkBrush}" />
                                            <TextBlock Text="Expected in drawer" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="Plus the opening float." Style="{StaticResource FormHint}" />
                                    </StackPanel>
                                </Border>

                                <!-- Customer accounts -->
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,16,16">
                                    <StackPanel>
                                        <TextBlock Text="CUSTOMER ACCOUNTS" Style="{StaticResource SectionTitle}" />
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.AccountCharges, StringFormat={}{0:C}}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="Charged to accounts" FontSize="15" />
                                        </DockPanel>
                                        <TextBlock Text="Paid on accounts" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,2" />
                                        <ItemsControl ItemsSource="{Binding Summary.AccountPaymentsByMethod}" ItemTemplate="{StaticResource NamedTotalRow}" />
                                    </StackPanel>
                                </Border>

                                <!-- Refunds -->
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,16,16">
                                    <StackPanel>
                                        <TextBlock Text="REFUNDS" Style="{StaticResource SectionTitle}" />
                                        <ItemsControl ItemsSource="{Binding Summary.Refunds}" ItemTemplate="{StaticResource NamedTotalRow}" />
                                        <DockPanel Margin="0,8,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.NetSales, StringFormat={}{0:C}}" FontSize="20" FontWeight="Black" />
                                            <TextBlock Text="Net sales (after refunds)" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Cashiers -->
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,16,16">
                                    <StackPanel>
                                        <TextBlock Text="CASHIERS" Style="{StaticResource SectionTitle}" />
                                        <ItemsControl ItemsSource="{Binding Summary.ByCashier}" ItemTemplate="{StaticResource NamedTotalRow}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Top items -->
                            <Border Style="{StaticResource Card}" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="TOP ITEMS" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding Summary.TopProducts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="110" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="15" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0} sold}" FontSize="15" HorizontalAlignment="Right"
                                                               Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Revenue, StringFormat={}{0:C}}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No sales in this period." Style="{StaticResource Muted}"
                                               Visibility="{Binding HasSales, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Printable report preview -->
                    <DockPanel Grid.Column="2">
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Command="{Binding PrintReportCommand}">
                            <TextBlock Text="Print Report" />
                        </Button>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16,14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ReportLines}" ItemTemplate="{StaticResource PaperLine}" />
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- ===== Sales list ===== -->
                <Grid Visibility="{Binding IsSalesTab, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" CornerRadius="12">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="16,10,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RECEIPT" Style="{StaticResource FormLabel}" />
                                <TextBlock Grid.Column="1" Text="TIME" Style="{StaticResource FormLabel}" />
                                <TextBlock Grid.Column="2" Text="CASHIER" Style="{StaticResource FormLabel}" />
                                <TextBlock Grid.Column="3" Text="CUSTOMER" Style="{StaticResource FormLabel}" />
                                <TextBlock Grid.Column="4" Text="PAID BY" Style="{StaticResource FormLabel}" />
                                <TextBlock Grid.Column="5" Text="TOTAL" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                <ItemsControl ItemsSource="{Binding Sales}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                                    Background="Transparent" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                                                  Command="{Binding DataContext.SelectSaleCommand, RelativeSource={RelativeSource AncestorType=views:ReportsView}}" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Sale.ReceiptNumber}" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Sale.Time, StringFormat={}{0:MMM d  h:mm tt}}" FontSize="15" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Sale.Cashier}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Sale.Customer}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Sale.PaidBy}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Sale.Total, StringFormat={}{0:C}}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Receipt preview + reprint -->
                    <DockPanel Grid.Column="2">
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Command="{Binding ReprintCommand}"
                                IsEnabled="{Binding HasSelectedSale}">
                            <TextBlock Text="Reprint Receipt" />
                        </Button>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16,14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ReceiptLines}" ItemTemplate="{StaticResource PaperLine}" />
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- ===== Shifts: opening float, expected vs counted cash per register ===== -->
                <Grid Visibility="{Binding IsShiftsTab, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" CornerRadius="12">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="16,10,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="REGISTER" Style="{StaticResource FormLabel}" />
                                <TextBlock Grid.Column="1" Text="OPENED" Style="{StaticResource FormLabel}" />
                                <TextBlock Grid.Column="2" Text="CLOSED" Style="{StaticResource FormLabel}" />
                                <TextBlock Grid.Column="3" Text="FLOAT" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="EXPECTED" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="COUNTED" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="OVER/SHORT" Style="{StaticResource FormLabel}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="No shifts were opened in this period." Style="{StaticResource Muted}" FontSize="17"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasShifts, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                    <ItemsControl ItemsSource="{Binding Shifts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" Padding="16,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                                        Background="Transparent" Cursor="Hand">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                                                      Command="{Binding DataContext.SelectShiftCommand, RelativeSource={RelativeSource AncestorType=views:ReportsView}}" />
                                                    </Border.InputBindings>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="100" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Shift.Terminal}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" FontSize="15" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Shift.OpenedAt, Mode=OneWay, StringFormat='{}{0:MMM d  h:mm tt}'}" /><Run Text="{Binding Shift.OpenedBy, Mode=OneWay, StringFormat='{}  ·  {0}'}" Foreground="{StaticResource MutedTextBrush}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2" FontSize="15" TextTrimming="CharacterEllipsis" Text="{Binding ClosedText}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Shift.OpeningFloat, StringFormat={}{0:C}}" FontSize="15" HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Shift.ExpectedCash, StringFormat={}{0:C}}" FontSize="15" HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="5" Text="{Binding Shift.CountedCash, StringFormat={}{0:C}}" FontSize="15" HorizontalAlignment="Right" />
                                                        <TextBlock x:Name="Diff" Grid.Column="6" Text="{Binding Shift.Difference, StringFormat={}{0:+$0.00;−$0.00;$0.00}}" FontSize="15"
                                                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsShort}" Value="True">
                                                        <Setter TargetName="Diff" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Shift report preview + reprint -->
                    <DockPanel Grid.Column="2">
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Command="{Binding PrintShiftCommand}"
                                IsEnabled="{Binding HasSelectedShift}">
                            <TextBlock Text="Print Shift Report" />
                        </Button>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16,14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ShiftLines}" ItemTemplate="{StaticResource PaperLine}" />
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>

                <Border Background="#99F1F5F9" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Loading…" Style="{StaticResource Heading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
