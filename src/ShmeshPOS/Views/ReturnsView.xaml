<UserControl x:Class="ShmeshPOS.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ShmeshPOS.Views">
    <UserControl.Resources>
        <Style x:Key="MethodButton" TargetType="Button" BasedOn="{StaticResource PosButton}">
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderThickness" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource OverlayBrush}">
        <Border Style="{StaticResource OverlayCard}" Width="980" MaxHeight="680">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Esc to go back" />
                    <TextBlock Text="RETURNS" Style="{StaticResource Heading}" />
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" TextAlignment="Left" Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

                <Grid>
                    <!-- ===== Find the sale ===== -->
                    <StackPanel Visibility="{Binding IsFindStage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Scan the barcode on the receipt, or type its receipt number (e.g. 2026-000123)." FontSize="17"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Find Sale" Style="{StaticResource PrimaryButton}" MinWidth="170" Margin="12,0,0,0"
                                    Command="{Binding FindCommand}" />
                            <TextBox x:Name="ReceiptBox" Style="{StaticResource FormBox}" Height="56" FontSize="22" FontFamily="Consolas"
                                     Text="{Binding ReceiptText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <Button Content="Cancel" Style="{StaticResource PosButton}" HorizontalAlignment="Left" MinWidth="160" Margin="0,24,0,0"
                                Command="{Binding BackCommand}" />
                    </StackPanel>

                    <!-- ===== Choose items and refund method ===== -->
                    <Grid Visibility="{Binding HasSale, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">
                                    <Run Text="Receipt" /><Run Text="{Binding Sale.ReceiptNumber, Mode=OneWay, StringFormat={} {0}}" FontFamily="Consolas" /><Run Text="{Binding Sale.Total, Mode=OneWay, StringFormat={}   ·   {0:C}}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="{Binding Sale.Time, Mode=OneWay, StringFormat={}{0:ddd d MMM yyyy, h:mm tt}}" /><Run Text="{Binding Sale.Cashier, Mode=OneWay, StringFormat={}   ·   {0}}" /><Run Text="{Binding Sale.CustomerName, Mode=OneWay, StringFormat={}   ·   customer {0}}" /><Run Text="   ·   paid: " /><Run Text="{Binding OriginalPayments, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource DangerBrush}"
                                           Text="{Binding Sale.AlreadyRefunded, StringFormat=Already refunded: {0:C}}"
                                           Visibility="{Binding HasPreviousRefunds, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <Button DockPanel.Dock="Bottom" Content="Return Everything" Style="{StaticResource PosButton}" HorizontalAlignment="Left"
                                    MinHeight="46" FontSize="16" Margin="0,10,0,0" Command="{Binding ReturnAllCommand}" />

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="14,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Line.Name}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                            <TextBlock Style="{StaticResource Muted}" FontSize="13">
                                                                <Run Text="{Binding Line.Sold, Mode=OneWay, StringFormat={}Bought {0}}" /><Run Text="{Binding Line.UnitPrice, Mode=OneWay, StringFormat={} × {0:C}}" /><Run Text="{Binding Line.AlreadyReturned, Mode=OneWay, StringFormat={}   ·   {0} already returned}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding CanReturn}">
                                                            <Button Style="{StaticResource QtyButton}" Content="−" Command="{Binding DecreaseCommand}" />
                                                            <TextBlock Text="{Binding Quantity}" FontSize="20" FontWeight="Bold" Width="46" TextAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <Button Style="{StaticResource QtyButton}" Content="+" Command="{Binding IncreaseCommand}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:C}}" FontSize="17" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>

                        <DockPanel Grid.Column="2">
                            <UniformGrid DockPanel.Dock="Bottom" Rows="2">
                                <Button Style="{StaticResource SuccessButton}" Margin="5" Height="72" FontSize="20" Command="{Binding CompleteCommand}"
                                        IsEnabled="{Binding CanComplete}">
                                    <TextBlock><Run Text="REFUND " /><Run Text="{Binding RefundTotal, Mode=OneWay, StringFormat={}{0:C}}" /></TextBlock>
                                </Button>
                                <Button Content="Back" Style="{StaticResource PosButton}" Margin="5" Command="{Binding BackCommand}" />
                            </UniformGrid>
                            <StackPanel>
                                <TextBlock Text="GIVE THE MONEY BACK AS" Style="{StaticResource FormLabel}" Margin="5,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Methods}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MethodButton}" Content="{Binding Name}" FontSize="15"
                                                    Command="{Binding DataContext.SelectMethodCommand, RelativeSource={RelativeSource AncestorType=views:ReturnsView}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="REASON (optional)" Style="{StaticResource FormLabel}" Margin="5,14,0,4" />
                                <TextBox Style="{StaticResource FormBox}" MaxLength="200" Margin="5,0" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                    <Border Background="#CCFFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Working…" Style="{StaticResource Heading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
