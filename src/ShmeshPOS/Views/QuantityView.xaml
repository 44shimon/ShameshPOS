<UserControl x:Class="ShmeshPOS.Views.QuantityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ShmeshPOS.Controls">
    <Grid Background="{StaticResource OverlayBrush}">
        <Border Style="{StaticResource OverlayCard}" Width="380">
            <StackPanel>
                <TextBlock Text="QUANTITY" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding Line.Name}" Style="{StaticResource Muted}" FontSize="18" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource Muted}" FontSize="14">
                    <Run Text="Currently " /><Run Text="{Binding Line.Quantity, Mode=OneWay}" /><Run Text=" · enter 0 to remove" />
                </TextBlock>

                <Border Background="White" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="10"
                        Height="68" Margin="0,14,0,10">
                    <TextBlock Text="{Binding Text}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="14,0" Foreground="{StaticResource TextBrush}" />
                </Border>

                <controls:NumericKeypad Command="{Binding KeypadCommand}" Height="290" Margin="-5,0" />

                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <Button Content="Cancel" Style="{StaticResource PosButton}" Margin="0,0,6,0" Command="{Binding CancelCommand}" />
                    <Button Content="OK" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Command="{Binding ConfirmCommand}" />
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
