<UserControl x:Class="ShmeshPOS.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ShmeshPOS.Views">
    <!-- Clicking the dimmed area outside the card closes the menu (see code-behind). -->
    <Grid x:Name="OverlayRoot" Background="{StaticResource OverlayBrush}" MouseLeftButtonUp="OnOverlayClicked">

        <Border Style="{StaticResource OverlayCard}" Width="440" Padding="20,22">
            <StackPanel>
                <DockPanel Margin="8,0,8,14">
                    <TextBlock DockPanel.Dock="Right" Text="Esc to close" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="SHMESH POS" Style="{StaticResource Heading}" />
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Item" Style="{StaticResource PosButton}" Margin="0,3" MinHeight="52"
                                    HorizontalContentAlignment="Stretch" BorderThickness="2"
                                    IsEnabled="{Binding IsEnabled}"
                                    Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=views:MenuView}}"
                                    CommandParameter="{Binding}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="6" Margin="0,0,14,0"
                                            Background="{StaticResource AppBackgroundBrush}">
                                        <TextBlock Text="{Binding Shortcut}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                    <Setter TargetName="Item" Property="Background" Value="{StaticResource SelectionBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
