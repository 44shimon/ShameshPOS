<UserControl x:Class="ShmeshPOS.Views.DiscountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ShmeshPOS.Views"
             xmlns:controls="clr-namespace:ShmeshPOS.Controls">
    <UserControl.Resources>
        <!-- Two-way toggle buttons: highlighted when their DataTrigger matches. -->
        <Style x:Key="ToggleBase" TargetType="Button" BasedOn="{StaticResource PosButton}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource OverlayBrush}">
        <Border Style="{StaticResource OverlayCard}" Width="760">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="290" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Esc to cancel" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="DISCOUNT" Style="{StaticResource Heading}" />
                    </DockPanel>

                    <TextBlock Text="TAKE IT OFF" Style="{StaticResource FormLabel}" Margin="0,16,0,4" />
                    <UniformGrid Columns="2" Margin="-4,0">
                        <Button Command="{Binding SetTargetCommand}" CommandParameter="Item" IsEnabled="{Binding HasLine}">
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="This item" /><Run Text="{Binding Line.Name, Mode=OneWay, StringFormat={}: {0}}" />
                            </TextBlock>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToggleBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWholeSale}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Whole sale" Command="{Binding SetTargetCommand}" CommandParameter="Sale">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToggleBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWholeSale}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>

                    <TextBlock Text="AS" Style="{StaticResource FormLabel}" Margin="0,12,0,4" />
                    <UniformGrid Columns="2" Margin="-4,0">
                        <Button Content="Percent  %" Command="{Binding SetKindCommand}" CommandParameter="Percent">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToggleBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPercent}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Amount  $" Command="{Binding SetKindCommand}" CommandParameter="Amount">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToggleBase}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPercent}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>

                    <Border Background="White" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="10"
                            Height="64" Margin="0,14,0,0">
                        <DockPanel Margin="14,0">
                            <TextBlock DockPanel.Dock="Right" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" Text="%"
                                       Visibility="{Binding IsPercent, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding ValueText}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" />
                        </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding QuickPercents}" Margin="-4,8,-4,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PosButton}" Margin="4" FontSize="16" Padding="2,8"
                                        Content="{Binding}" ContentStringFormat="{}{0}%"
                                        Command="{Binding DataContext.QuickPercentCommand, RelativeSource={RelativeSource AncestorType=views:DiscountView}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,14,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding AmountOff, StringFormat={}−{0:C}}" FontSize="30" FontWeight="Black"
                                   Foreground="{StaticResource SuccessDarkBrush}" />
                        <TextBlock VerticalAlignment="Center" FontSize="17" Foreground="{StaticResource TextBrush}">
                            <Run Text="Off" /><Run Text="{Binding TargetText, Mode=OneWay, StringFormat={} {0}}" FontWeight="Bold" /><Run Text="{Binding BasePrice, Mode=OneWay, StringFormat={} ({0:C})}" Foreground="{StaticResource MutedTextBrush}" />
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="Discounts come off the price before tax." Style="{StaticResource FormHint}" />

                    <TextBlock Text="{Binding Problem}" Style="{StaticResource ErrorText}" TextAlignment="Left" Margin="0,10,0,0"
                               Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>

                <DockPanel Grid.Column="2">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Style="{StaticResource SuccessButton}" Margin="5" Height="70" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}">
                            <TextBlock><Run Text="APPLY" /><Run Text="  ⏎" FontSize="18" /></TextBlock>
                        </Button>
                        <UniformGrid Columns="2">
                            <Button Content="Remove" Style="{StaticResource DangerButton}" Margin="5" Command="{Binding RemoveCommand}"
                                    IsEnabled="{Binding HasCurrent}" />
                            <Button Content="Cancel" Style="{StaticResource PosButton}" Margin="5" Command="{Binding CancelCommand}" />
                        </UniformGrid>
                    </StackPanel>
                    <controls:NumericKeypad Command="{Binding KeypadCommand}" ShowDecimal="True" Margin="0,36,0,0" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
