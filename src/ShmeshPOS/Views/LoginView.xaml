<UserControl x:Class="ShmeshPOS.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ShmeshPOS.Controls">
    <Grid Background="{StaticResource ChromeBrush}">
        <Border Style="{StaticResource Card}" Width="420" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="SHMESH POS" FontSize="40" FontWeight="Black" HorizontalAlignment="Center"
                           Foreground="{StaticResource ChromeBrush}" />
                <TextBlock Text="Enter PIN" Style="{StaticResource Muted}" FontSize="18" HorizontalAlignment="Center" Margin="0,6,0,0" />

                <!-- Masked PIN: dots only, the digits are never displayed or bound. -->
                <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Height="64" Margin="0,18,0,6">
                    <TextBlock Text="{Binding MaskedPin}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" />
                </Border>

                <Grid Height="28">
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" VerticalAlignment="Center" />
                </Grid>

                <controls:NumericKeypad Command="{Binding KeypadCommand}" Margin="-5,4,-5,0" Height="296" />

                <UniformGrid Columns="2" Margin="0,12,0,0">
                    <Button Content="CLEAR" Style="{StaticResource PosButton}" Margin="0,0,6,0" Command="{Binding ClearCommand}" />
                    <Button Content="LOGIN" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Command="{Binding LoginCommand}" />
                </UniformGrid>

                <TextBlock Text="Signing in…" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
