<UserControl x:Class="ShmeshPOS.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ShmeshPOS.Views"
             xmlns:controls="clr-namespace:ShmeshPOS.Controls">
    <UserControl.Resources>
        <Style x:Key="UserButton" TargetType="Button" BasedOn="{StaticResource PosButton}">
            <Setter Property="Height" Value="68" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ChromeBrush}">
        <Border Style="{StaticResource Card}" Width="860" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="356" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.ColumnSpan="3" Text="SHMESH POS" FontSize="36" FontWeight="Black" HorizontalAlignment="Center"
                           Foreground="{StaticResource ChromeBrush}" Margin="0,0,0,20" />

                <!-- ===== Who's working? ===== -->
                <DockPanel Grid.Row="1">
                    <TextBlock DockPanel.Dock="Top" Text="WHO'S WORKING?" Style="{StaticResource FormLabel}" FontSize="14" Margin="2,0,0,10" />
                    <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Users}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource UserButton}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.SelectUserCommand, RelativeSource={RelativeSource AncestorType=views:LoginView}}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{StaticResource ChromeBrush}"
                                                    Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="17" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding RoleText}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ===== PIN ===== -->
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="{Binding Prompt}" FontSize="17" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource MutedTextBrush}" />

                    <!-- Masked PIN: dots only, the digits are never displayed or bound. -->
                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Height="60" Margin="0,10,0,4">
                        <TextBlock Text="{Binding MaskedPin}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" />
                    </Border>

                    <Grid Height="28">
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" VerticalAlignment="Center" />
                    </Grid>

                    <controls:NumericKeypad Command="{Binding KeypadCommand}" Margin="-5,0" Height="284" IsEnabled="{Binding HasSelectedUser}" />

                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <Button Content="CLEAR" Style="{StaticResource PosButton}" Margin="0,0,6,0" Command="{Binding ClearCommand}" />
                        <Button Content="LOGIN" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Command="{Binding LoginCommand}" />
                    </UniformGrid>

                    <TextBlock Text="Signing in…" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
