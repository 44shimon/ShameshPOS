<UserControl x:Class="ShmeshPOS.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ShmeshPOS.Views">
    <UserControl.Resources>
        <!-- Small tiles for search results. -->
        <Style x:Key="ProductTile" TargetType="Button" BasedOn="{StaticResource PosButton}">
            <Setter Property="Width" Value="172" />
            <Setter Property="Height" Value="112" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Big main-screen buttons: they stretch to fill a 2 x 5 grid. -->
        <Style x:Key="MainTile" TargetType="Button" BasedOn="{StaticResource PosButton}">
            <Setter Property="Margin" Value="7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="MainTileContent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="9,9,0,0" Background="{Binding Category.Color, TargetNullValue=#64748B, FallbackValue=#64748B}" />
                <Viewbox Grid.Row="1" StretchDirection="DownOnly" Margin="12,6">
                    <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" />
                </Viewbox>
                <TextBlock Grid.Row="2" Text="{Binding Price, StringFormat={}{0:C}}" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Top bar: brand, search (top-left), cashier ===== -->
        <Border Grid.Row="0" Background="{StaticResource ChromeBrush}">
            <DockPanel Margin="20,0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="SHMESH POS" FontSize="26" FontWeight="Black" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,24,0" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CashierName}" FontSize="17" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" />
                        <TextBlock FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Right">
                            <Run Text="{Binding TerminalName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Now, Mode=OneWay, StringFormat={}{0:ddd h:mm tt}}" />
                        </TextBlock>
                        <TextBlock Text="{Binding ShiftText}" FontSize="13" HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentShift}" Value="{x:Null}">
                                            <Setter Property="Foreground" Value="#FCD34D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Style="{StaticResource ChromeButton}" Command="{Binding OpenMenuCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MENU" />
                            <Border Style="{StaticResource KeyHint}"><TextBlock Text="F3" FontSize="13" /></Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Width="460" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="⌕" FontSize="24" Foreground="{StaticResource MutedTextBrush}" Margin="14,0,0,2"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="Search name, code, SKU or scan barcode…  (F2)" FontSize="17" Margin="44,0,0,0"
                               Foreground="#94A3B8" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Current sale 65% of the width, item buttons 35%. -->
                <ColumnDefinition Width="65*" />
                <ColumnDefinition Width="35*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Right: main-screen items, or search results while typing ===== -->
            <Grid Grid.Column="1" Margin="8,16,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Main screen: the (up to) ten items chosen in Administration, as big buttons -->
                <Grid Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <ItemsControl ItemsSource="{Binding MainScreenProducts}" Margin="-7">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" Rows="5" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MainTile}" ContentTemplate="{StaticResource MainTileContent}" Content="{Binding}"
                                        Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=views:PosView}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"
                                Visibility="{Binding HasMainScreenProducts, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="No items on the main screen yet" Style="{StaticResource Heading}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="17" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                   Text="An administrator can choose up to 10 in F3 &#x2192; Administration &#x2192; Products by ticking &#x201C;Show on main screen&#x201D;. Meanwhile, search or scan to add items." />
                    </StackPanel>
                </Grid>

                <!-- Search results -->
                <DockPanel Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="16" Margin="2,0,0,10"
                               Text="Search results   &#x00B7;   Enter adds the first one   &#x00B7;   Esc goes back to the main screen" />
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                            <ItemsControl ItemsSource="{Binding VisibleProducts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ProductTile}"
                                                Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=views:PosView}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="6" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" CornerRadius="9,9,0,0"
                                                        Background="{Binding Category.Color, TargetNullValue=#64748B, FallbackValue=#64748B}" />
                                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           TextAlignment="Center" VerticalAlignment="Center" Margin="10,4" />
                                                <TextBlock Grid.Row="2" Text="{Binding Price, StringFormat={}{0:C}}" FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="No products found." FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VisibleProducts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <!-- Status line + shortcut legend -->
                <DockPanel Grid.Row="1" Height="44">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"
                               Text="F2 Search   ·   F3 Menu   ·   F4 Customer   ·   F6 Discount   ·   F8 Pay   ·   Del Remove   ·   +/− Qty" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryDarkBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>

            <!-- ===== Left: current sale ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="20,16,8,20" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,16,20,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Bottom">
                                <Run Text="{Binding Cart.ItemCount, Mode=OneWay}" /><Run Text=" items" />
                            </TextBlock>
                            <TextBlock Text="CURRENT SALE" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        </DockPanel>

                        <!-- Customer: add button, or the attached customer's account summary -->
                        <Button Style="{StaticResource PosButton}" MinHeight="44" FontSize="16" Margin="0,10,0,0"
                                HorizontalContentAlignment="Left" Command="{Binding OpenCustomerLookupCommand}"
                                Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource KeyHint}" Background="{StaticResource AppBackgroundBrush}">
                                    <TextBlock Text="F4" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                </Border>
                                <TextBlock Text="+  Add customer" Foreground="{StaticResource PrimaryBrush}" />
                            </DockPanel>
                        </Button>
                        <Border Margin="0,10,0,0" Padding="14,8,6,8" CornerRadius="10" Background="{StaticResource SelectionBrush}"
                                Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PosButton}" Content="✕" Width="40" Height="40" MinHeight="40"
                                        Padding="0" FontSize="16" BorderThickness="0" Background="Transparent" ToolTip="Remove customer"
                                        Command="{Binding RemoveCustomerCommand}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Customer.Name, Mode=OneWay}" /><Run Text="  #" FontWeight="Normal" Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding Customer.AccountNumber, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource MutedTextBrush}" />
                                    </TextBlock>
                                    <TextBlock FontSize="14" Foreground="{StaticResource MutedTextBrush}">
                                        <Run Text="Owes" /><Run Text="{Binding Customer.Balance, Mode=OneWay, StringFormat={} {0:C}}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" /><Run Text="   ·   Available" /><Run Text="{Binding Customer.AvailableCredit, Mode=OneWay, StringFormat={} {0:C}}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" /><Run Text="{Binding Customer.CreditLimit, Mode=OneWay, StringFormat={} of {0:C}}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1">
                        <Grid>
                            <TextBlock Text="Tap a product or scan an item to start a sale." Style="{StaticResource Muted}" FontSize="17"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="40,0" VerticalAlignment="Center"
                                       Visibility="{Binding Cart.IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                            <ScrollViewer x:Name="CartScroll" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                <ItemsControl ItemsSource="{Binding Cart.Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" Padding="16,10,12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                                    Background="Transparent" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectLineCommand, RelativeSource={RelativeSource AncestorType=views:PosView}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="86" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Style="{StaticResource Muted}" FontSize="14"
                                                                   Text="{Binding UnitPrice, StringFormat={}{0:C} each}" />
                                                        <TextBlock Text="{Binding DiscountText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"
                                                                   Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource QtyButton}" Content="−"
                                                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=views:PosView}}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock Text="{Binding Quantity}" FontSize="20" FontWeight="Bold" Width="44" TextAlignment="Center"
                                                                   VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                                        <Button Style="{StaticResource QtyButton}" Content="+"
                                                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=views:PosView}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding LineTotal, StringFormat={}{0:C}}" FontSize="18" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Line actions for the selected item -->
                    <UniformGrid Grid.Row="2" Rows="1" Margin="14,12,14,4">
                        <Button Content="Qty…" Style="{StaticResource PosButton}" Margin="4" Padding="4,8" FontSize="17" Command="{Binding ChangeQuantityCommand}" />
                        <Button Content="Discount…" Style="{StaticResource PosButton}" Margin="4" Padding="4,8" FontSize="17" Command="{Binding OpenDiscountCommand}"
                                Visibility="{Binding CanApplyDiscounts, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Remove" Style="{StaticResource PosButton}" Margin="4" Padding="4,8" FontSize="17" Command="{Binding RemoveLineCommand}" />
                        <Button Content="Cancel Sale" Style="{StaticResource DangerButton}" Margin="4" Padding="4,8" FontSize="17" Command="{Binding ClearSaleCommand}" />
                    </UniformGrid>

                    <!-- Totals -->
                    <Grid Grid.Row="3" Margin="22,8,22,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,4" Visibility="{Binding Cart.HasSaleDiscount, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Cart.SaleDiscountAmount, StringFormat={}−{0:C}}" FontSize="17"
                                       FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock FontSize="17" Foreground="{StaticResource SuccessBrush}">
                                <Run Text="Sale discount " /><Run Text="{Binding Cart.SaleDiscount.Label, Mode=OneWay, StringFormat={}({0})}" />
                            </TextBlock>
                        </DockPanel>
                        <DockPanel Grid.Row="1">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Cart.Subtotal, StringFormat={}{0:C}}" FontSize="17" />
                            <TextBlock Text="Subtotal" Style="{StaticResource Muted}" FontSize="17" />
                        </DockPanel>
                        <DockPanel Grid.Row="2" Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Cart.Tax, StringFormat={}{0:C}}" FontSize="17" />
                            <TextBlock Text="Tax" Style="{StaticResource Muted}" FontSize="17" />
                        </DockPanel>
                        <DockPanel Grid.Row="3" Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Cart.Total, StringFormat={}{0:C}}" FontSize="36" FontWeight="Black"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="TOTAL" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                        </DockPanel>
                    </Grid>

                    <Button Grid.Row="4" Style="{StaticResource SuccessButton}" Height="84" Margin="18,6,18,18" Command="{Binding OpenPaymentCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PAY" />
                            <Border Style="{StaticResource KeyHint}" Margin="12,0,0,0"><TextBlock Text="F8" FontSize="15" /></Border>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Overlays ===== -->
        <views:MenuView Grid.RowSpan="2" DataContext="{Binding Menu}"
                        Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
        <ContentControl Grid.RowSpan="2" Content="{Binding Payment}" Focusable="False" />
        <ContentControl Grid.RowSpan="2" Content="{Binding QuantityEntry}" Focusable="False" />
        <ContentControl Grid.RowSpan="2" Content="{Binding CustomerLookup}" Focusable="False" />
        <ContentControl Grid.RowSpan="2" Content="{Binding HeldSales}" Focusable="False" />
        <ContentControl Grid.RowSpan="2" Content="{Binding Returns}" Focusable="False" />
        <ContentControl Grid.RowSpan="2" Content="{Binding DiscountEntry}" Focusable="False" />
        <ContentControl Grid.RowSpan="2" Content="{Binding Shift}" Focusable="False" />
    </Grid>
</UserControl>
