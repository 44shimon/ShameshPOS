<UserControl x:Class="ShmeshPOS.Views.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ShmeshPOS.Views"
             xmlns:controls="clr-namespace:ShmeshPOS.Controls">
    <UserControl.Resources>
        <Style x:Key="MethodButton" TargetType="Button" BasedOn="{StaticResource PosButton}">
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="BorderThickness" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource OverlayBrush}">
        <Border Style="{StaticResource OverlayCard}" Width="900">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Left: total, parts paid, methods, amount -->
                <StackPanel Grid.Column="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Esc to cancel" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="PAYMENT" Style="{StaticResource Heading}" />
                    </DockPanel>

                    <Border Background="{StaticResource ChromeBrush}" CornerRadius="12" Padding="20,12" Margin="0,14,0,10">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="TOTAL DUE" FontSize="20" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Total, StringFormat={}{0:C}}" FontSize="40" FontWeight="Black" Foreground="White"
                                           HorizontalAlignment="Right" />
                            </DockPanel>

                            <!-- Parts already taken (split payment) -->
                            <StackPanel Visibility="{Binding HasParts, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                                <ItemsControl ItemsSource="{Binding Parts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="✕" Width="36" Height="32" MinHeight="32"
                                                        Padding="0" FontSize="14" Margin="10,0,0,0" ToolTip="Remove this payment"
                                                        Command="{Binding DataContext.RemovePartCommand, RelativeSource={RelativeSource AncestorType=views:PaymentView}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, StringFormat={}−{0:C}}" FontSize="18" FontWeight="SemiBold"
                                                           Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name, StringFormat=Paid by {0}}" FontSize="16" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="STILL DUE" FontSize="20" FontWeight="SemiBold" Foreground="#FDE68A" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Remaining, StringFormat={}{0:C}}" FontSize="36" FontWeight="Black" Foreground="#FDE68A"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Methods}" Margin="-6,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MethodButton}" Content="{Binding Name}"
                                        Command="{Binding DataContext.SelectMethodCommand, RelativeSource={RelativeSource AncestorType=views:PaymentView}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Amount: cash received, or the amount of this part -->
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding AmountLabel}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="AmountBox" Style="{StaticResource AmountBox}"
                                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />

                        <ItemsControl ItemsSource="{Binding QuickCashAmounts}" Margin="-4,8,-4,0"
                                      Visibility="{Binding IsCash, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PosButton}" Margin="4" FontSize="16" Padding="2,8"
                                            Content="{Binding}" ContentStringFormat="{}{0:C}"
                                            Command="{Binding DataContext.QuickCashCommand, RelativeSource={RelativeSource AncestorType=views:PaymentView}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,12,0,0" Visibility="{Binding IsCash, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="CHANGE" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                            <TextBlock HorizontalAlignment="Right" FontSize="34" FontWeight="Black" Foreground="{StaticResource SuccessBrush}"
                                       Text="{Binding Change, StringFormat={}{0:C}, TargetNullValue=—}" />
                        </DockPanel>
                        <!-- Less than is due: this becomes a part payment -->
                        <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,4,0,0"
                                   Text="{Binding AmountShort, StringFormat=Split payment: {0:C} will still be due}"
                                   Visibility="{Binding AmountShort, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>

                    <!-- Card / other -->
                    <TextBlock Margin="0,14,0,0" FontSize="17" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                               Text="Process the amount on the card terminal, then press COMPLETE. Enter less to pay the rest another way."
                               Visibility="{Binding IsCardOrOther, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Charge to account -->
                    <Border Margin="0,14,0,0" Padding="18,12" CornerRadius="12" Background="{StaticResource SelectionBrush}"
                            Visibility="{Binding IsAccount, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}">
                                <Run Text="Charge to" /><Run Text="{Binding Customer.Name, Mode=OneWay, StringFormat={} {0}}" /><Run Text="{Binding Customer.AccountNumber, Mode=OneWay, StringFormat={}  #{0}}" FontWeight="Normal" Foreground="{StaticResource MutedTextBrush}" />
                            </TextBlock>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="OWES NOW" Style="{StaticResource FormLabel}" />
                                    <TextBlock Text="{Binding Customer.Balance, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="AVAILABLE" Style="{StaticResource FormLabel}" />
                                    <TextBlock Text="{Binding Customer.AvailableCredit, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="LIMIT" Style="{StaticResource FormLabel}" />
                                    <TextBlock Text="{Binding Customer.CreditLimit, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Problem}" Style="{StaticResource ErrorText}" TextAlignment="Left" Margin="0,10,0,0"
                               Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,10,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>

                <!-- Right: keypad + actions -->
                <DockPanel Grid.Column="2">
                    <UniformGrid DockPanel.Dock="Bottom" Rows="2" Margin="0,10,0,0">
                        <Button Style="{StaticResource SuccessButton}" Margin="5" Height="76" Command="{Binding CompleteCommand}"
                                IsEnabled="{Binding CanComplete}">
                            <TextBlock>
                                <Run Text="{Binding ActionText, Mode=OneWay}" /><Run Text="  ⏎" FontSize="18" />
                            </TextBlock>
                        </Button>
                        <Button Content="Cancel" Style="{StaticResource PosButton}" Margin="5" Command="{Binding CancelCommand}" />
                    </UniformGrid>
                    <controls:NumericKeypad Command="{Binding KeypadCommand}" ShowDecimal="True" Margin="0,40,0,0" />
                </DockPanel>

                <!-- Busy veil while the sale is being written -->
                <Border Grid.ColumnSpan="3" Background="#CCFFFFFF" CornerRadius="12"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Completing sale…" Style="{StaticResource Heading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
