<UserControl x:Class="ShmeshPOS.Views.CustomerLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ShmeshPOS.Views"
             xmlns:controls="clr-namespace:ShmeshPOS.Controls">
    <UserControl.Resources>
        <Style x:Key="MethodButton" TargetType="Button" BasedOn="{StaticResource PosButton}">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderThickness" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource OverlayBrush}">
        <Border Style="{StaticResource OverlayCard}" Width="820" Height="640">
            <Grid>
                <!-- ===== Search mode ===== -->
                <DockPanel Visibility="{Binding IsPaymentMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock DockPanel.Dock="Right" Text="Esc to close  ·  ↑↓ Enter to choose" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="CUSTOMER" Style="{StaticResource Heading}" />
                    </DockPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,16,0,12">
                        <TextBox x:Name="SearchBox" Style="{StaticResource FormBox}" Height="52" FontSize="20"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Name, account number or phone…" FontSize="19" Foreground="#94A3B8" Margin="12,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="17" Margin="4,8"
                               TextWrapping="Wrap" Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Padding="16,10,10,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="Transparent">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Take Payment" Style="{StaticResource PosButton}" FontSize="15" MinHeight="46" Margin="0,0,8,0"
                                                            Command="{Binding DataContext.StartPaymentCommand, RelativeSource={RelativeSource AncestorType=views:CustomerLookupView}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Add to Sale" Style="{StaticResource PrimaryButton}" FontSize="15" MinHeight="46"
                                                            Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=views:CustomerLookupView}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Account.Name, Mode=OneWay}" /><Run Text="   #" FontWeight="Normal" Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding Account.AccountNumber, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource MutedTextBrush}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="14" Foreground="{StaticResource MutedTextBrush}">
                                                        <Run Text="Owes" /><Run Text="{Binding Account.Balance, Mode=OneWay, StringFormat={} {0:C}}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run Text="   ·   Available" /><Run Text="{Binding Account.AvailableCredit, Mode=OneWay, StringFormat={} {0:C}}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run Text="{Binding Account.CreditLimit, Mode=OneWay, StringFormat={} of {0:C}}" /><Run Text="{Binding Account.Phone, Mode=OneWay, StringFormat={}   ·   {0}}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <!-- ===== Account payment mode ===== -->
                <Grid Visibility="{Binding IsPaymentMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Esc to go back" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock Text="ACCOUNT PAYMENT" Style="{StaticResource Heading}" />
                        </DockPanel>
                        <TextBlock FontSize="19" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0">
                            <Run Text="{Binding PayingCustomer.Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   #" Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding PayingCustomer.AccountNumber, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" />
                        </TextBlock>

                        <Border Background="{StaticResource ChromeBrush}" CornerRadius="12" Padding="18,12" Margin="0,14,0,12">
                            <DockPanel>
                                <TextBlock Text="CURRENTLY OWES" FontSize="17" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PayingCustomer.Balance, StringFormat={}{0:C}}" FontSize="34" FontWeight="Black" Foreground="White" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>

                        <TextBlock Text="AMOUNT PAID" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="AmountBox" Style="{StaticResource AmountBox}" Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource PosButton}" FontSize="16" MinHeight="46" Margin="0,8,0,0" HorizontalAlignment="Left"
                                Command="{Binding PayFullBalanceCommand}">
                            <TextBlock><Run Text="Pay full balance" /><Run Text="{Binding PayingCustomer.Balance, Mode=OneWay, StringFormat={}  {0:C}}" /></TextBlock>
                        </Button>

                        <ItemsControl ItemsSource="{Binding PaymentMethods}" Margin="-5,12,-5,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MethodButton}" Content="{Binding Name}"
                                            Command="{Binding DataContext.SelectPaymentMethodCommand, RelativeSource={RelativeSource AncestorType=views:CustomerLookupView}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="NEW BALANCE" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                            <TextBlock HorizontalAlignment="Right" FontSize="28" FontWeight="Black" Foreground="{StaticResource SuccessBrush}"
                                       Text="{Binding BalanceAfterPayment, StringFormat={}{0:C}, TargetNullValue=—}" />
                        </DockPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>

                    <DockPanel Grid.Column="2">
                        <UniformGrid DockPanel.Dock="Bottom" Rows="2" Margin="0,10,0,0">
                            <Button Style="{StaticResource SuccessButton}" FontSize="21" Margin="5" Height="70" Command="{Binding ConfirmPaymentCommand}"
                                    IsEnabled="{Binding CanConfirmPayment}">
                                <TextBlock><Run Text="RECORD PAYMENT" /><Run Text="  ⏎" FontSize="16" /></TextBlock>
                            </Button>
                            <Button Content="Back" Style="{StaticResource PosButton}" Margin="5" Command="{Binding BackCommand}" />
                        </UniformGrid>
                        <controls:NumericKeypad Command="{Binding KeypadCommand}" ShowDecimal="True" Margin="0,40,0,0" />
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
