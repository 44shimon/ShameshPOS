<UserControl x:Class="ShmeshPOS.Controls.NumericKeypad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Each key sends its label as the command parameter: "0"-"9", "." , "CLR" or "BKSP". -->
    <UniformGrid Rows="4" Columns="3">
        <Button Style="{StaticResource KeypadButton}" Content="1" Command="{Binding Command, ElementName=Root}" CommandParameter="1" />
        <Button Style="{StaticResource KeypadButton}" Content="2" Command="{Binding Command, ElementName=Root}" CommandParameter="2" />
        <Button Style="{StaticResource KeypadButton}" Content="3" Command="{Binding Command, ElementName=Root}" CommandParameter="3" />
        <Button Style="{StaticResource KeypadButton}" Content="4" Command="{Binding Command, ElementName=Root}" CommandParameter="4" />
        <Button Style="{StaticResource KeypadButton}" Content="5" Command="{Binding Command, ElementName=Root}" CommandParameter="5" />
        <Button Style="{StaticResource KeypadButton}" Content="6" Command="{Binding Command, ElementName=Root}" CommandParameter="6" />
        <Button Style="{StaticResource KeypadButton}" Content="7" Command="{Binding Command, ElementName=Root}" CommandParameter="7" />
        <Button Style="{StaticResource KeypadButton}" Content="8" Command="{Binding Command, ElementName=Root}" CommandParameter="8" />
        <Button Style="{StaticResource KeypadButton}" Content="9" Command="{Binding Command, ElementName=Root}" CommandParameter="9" />
        <Button x:Name="LeftKey" Style="{StaticResource KeypadButton}" FontSize="20" Command="{Binding Command, ElementName=Root}" />
        <Button Style="{StaticResource KeypadButton}" Content="0" Command="{Binding Command, ElementName=Root}" CommandParameter="0" />
        <Button Style="{StaticResource KeypadButton}" Content="⌫" Command="{Binding Command, ElementName=Root}" CommandParameter="BKSP" />
    </UniformGrid>
</UserControl>
