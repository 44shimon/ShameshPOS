<Application x:Class="ShmeshPOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ShmeshPOS.ViewModels"
             xmlns:views="clr-namespace:ShmeshPOS.Views"
             xmlns:conv="clr-namespace:ShmeshPOS.Converters"
             xmlns:adminVm="clr-namespace:ShmeshPOS.ViewModels.Admin"
             xmlns:adminViews="clr-namespace:ShmeshPOS.Views.Admin"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:JoinNonEmptyConverter x:Key="JoinNonEmpty" />
            <conv:EqualsConverter x:Key="EqualsConverter" />
            <conv:UtcToLocalConverter x:Key="UtcToLocal" />

            <!-- View-model-first navigation: each view model is rendered by its view. -->
            <DataTemplate DataType="{x:Type vm:StartupViewModel}">
                <views:StartupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PosViewModel}">
                <views:PosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PaymentViewModel}">
                <views:PaymentView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuantityEntryViewModel}">
                <views:QuantityView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomerLookupViewModel}">
                <views:CustomerLookupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DialogViewModel}">
                <views:DialogView />
            </DataTemplate>

            <!-- Administration -->
            <DataTemplate DataType="{x:Type adminVm:AdministrationViewModel}">
                <adminViews:AdministrationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type adminVm:ProductsAdminViewModel}">
                <adminViews:ProductsAdminView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type adminVm:CategoriesAdminViewModel}">
                <adminViews:CategoriesAdminView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type adminVm:UsersAdminViewModel}">
                <adminViews:UsersAdminView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type adminVm:CustomersAdminViewModel}">
                <adminViews:CustomersAdminView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type adminVm:SettingsAdminViewModel}">
                <adminViews:SettingsAdminView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type adminVm:ImportViewModel}">
                <adminViews:ImportView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
